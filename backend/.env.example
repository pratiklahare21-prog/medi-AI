# ─────────────────────────────────────────────────────────────────────────────
# medi AI / SastaRx — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Express API server port
PORT=3001

# Gemini API Key (Required for AI features: OCR, Recommendations, Clinical Triage)
GEMINI_API_KEY=

# JWT Secret for session tokens (generate a strong key in production)
JWT_SECRET=medi-ai-sastarx-jwt-secure-key-2026

# Database connection URL (Optional: defaults to in-memory seeded store)
DATABASE_URL=postgresql://user:password@localhost:5432/sastarx_db

# Runtime environment (development / production)
NODE_ENV=development

# App URL
APP_URL=http://localhost:3001
