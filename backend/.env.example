# ─────────────────────────────────────────────────────────────────────────────
# medi AI / SastaRx — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `backend/.env` and fill in real values.
# NEVER commit the real .env file with production secrets.

# Express API server port
PORT=3001

# Runtime environment (development / production)
NODE_ENV=development

# Allowed frontend origin(s). Use commas to allow multiple origins.
# Development (Vite):  http://localhost:3000
# Production (Vercel): https://your-project.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Strong JWT signing secret.
# Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT leave empty or use the placeholder string below.
JWT_SECRET=

# Token lifetime (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# ── Integrations ─────────────────────────────────────────────────────────────
# Gemini API Key (AI features: OCR, Recommendations, Clinical Triage)
GEMINI_API_KEY=

# MongoDB / Prisma connection URL (optional; current app runs on in-memory store)
DATABASE_URL=

# Public backend URL used in emails / link generation (optional)
APP_URL=http://localhost:3001
