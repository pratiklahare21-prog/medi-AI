# ─────────────────────────────────────────────────────────────────────────────
# medi AI / SastaRx — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `frontend/.env` and fill in real values as needed.
# IMPORTANT: VITE_* variables are embedded into the client bundle.
#            NEVER put secrets (JWT keys, DB passwords, API keys) here.

# Backend API base URL (without trailing /api suffix).
# Development: http://localhost:3001
# Production (Render): https://your-project.onrender.com
VITE_API_URL=http://localhost:3001

# Legacy alias kept for backward compatibility
VITE_BACKEND_URL=http://localhost:3001

# Browser tab title
VITE_APP_TITLE=medi AI - SastaRx Ops & Discovery Platform
