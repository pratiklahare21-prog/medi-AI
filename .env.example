# ─────────────────────────────────────────────────────────────────────────────
# medi AI / SastaRx — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# All keys listed here are required unless marked "(optional)".
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, Recommendations, Search, Triage).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Express API server port (default 3001 in dev, 8080 in Cloud Run)
PORT="3001"

# JWT_SECRET: Secret key for signing session tokens (minimum 32 characters).
# Generate a strong value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-256-bit-secret-key-here-change-in-production"

# DATABASE_URL: PostgreSQL connection string (optional - falls back to in-memory relational store)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/sastarx_db"

# NODE_ENV: Runtime environment — "development", "staging", or "production"
# Controls: error detail exposure, rate limit enforcement, CSP strictness
NODE_ENV="development"

# FIREBASE_PROJECT_ID: (optional) Firebase project ID for Firebase Auth token verification.
# If not set, the server falls back to local JWT authentication.
# FIREBASE_PROJECT_ID="your-firebase-project-id"
